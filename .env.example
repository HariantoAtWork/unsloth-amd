# Copy to `.env` and adjust. Docker Compose loads `.env` automatically for
# ${VAR} substitution in docker-compose.yml.

# Image tag published by `docker compose build`
# UNSLOTH_TAG=1.0.0-torch2.10.0-rocm7.12.0

# Studio bind / publish port (host and container)
UNSLOTH_STUDIO_PORT=8888

# Studio listen address inside the container (keep 0.0.0.0 for Docker port publish)
UNSLOTH_STUDIO_HOST=0.0.0.0

# Admin password for Studio login (also used by the last-model watcher when needed).
# On first boot only: Unsloth uses this as the initial admin password.
# After the password is finalized, docker-studio.sh clears the env before launch
# (re-supplying it would abort Studio). Keep the value here for API login.
# Leave empty on first boot to use the generated bootstrap password.
UNSLOTH_STUDIO_PASSWORD=

# Stable Studio API key for external apps + autoload.
# If unset, one is created once at ~/.unsloth/.docker-api-key and reused.
# UNSLOTH_API_KEY=sk-unsloth-...

# Optional key file / display name when minting the stable key
# UNSLOTH_API_KEY_FILE=/root/.unsloth/.docker-api-key
# UNSLOTH_API_KEY_NAME=docker

# Reload last loaded model on container restart (1=on, 0=off)
UNSLOTH_AUTOLOAD_LAST_MODEL=1

# Path to last-model JSON on the volume (usually leave default)
# UNSLOTH_LAST_MODEL_FILE=/root/.unsloth/.docker-last-model.json

# How often the watcher polls /api/inference/status (seconds)
# UNSLOTH_LAST_MODEL_WATCH_SECONDS=15

# Skip automatic install.sh on first start (1=skip)
# UNSLOTH_SKIP_AUTO_INSTALL=0

# bitsandbytes: torch reports ROCm 7.12 but 0.49.x looks for libbitsandbytes_rocm82.so
# (and no wheel ships that). The image aliases missing tags to rocm72 on Studio start.
# BNB_ROCM_VERSION is used by bitsandbytes >= 0.50 only.
# BNB_ROCM_VERSION=72

# --- Build-time only (docker compose build / docker build --build-arg) ---
# ROCM_VERSION=7.2.4
# UNSLOTH_TORCH=2.10.0+rocm7.12.0
# UNSLOTH_TORCHVISION=0.25.0+rocm7.12.0
# UNSLOTH_TORCH_INDEX=https://repo.amd.com/rocm/whl/gfx1151/
